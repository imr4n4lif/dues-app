{
  "expo": {
    "name": "Dues",
    "slug": "dues-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "dues",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.dues.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dues.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0E9F6E"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-background-task",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9"
        }
      ],
      "./plugins/withExactAlarmPlugin"
    ],
    "extra": {
      "eas": {
        "projectId": "b85f689b-18cf-4528-ba23-3bef7a757bea"
      }
    }
  }
}
